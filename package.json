{
  "name": "@duckarchive/prisma",
  "version": "6.7.1",
  "description": "",
  "main": "index.js",
  "scripts": {
    "generate:inspector": "prisma generate --config prisma-inspector.config.ts",
    "generate:duckkey": "prisma generate --config prisma-duckkey.config.ts",
    "generate:duckarchive": "prisma generate --config prisma-duckarchive.config.ts",
    "generate:nest": "prisma generate --config prisma-nest.config.ts",
    "generate:druk": "prisma generate --config prisma-druk.config.ts",
    "generate": "npm run generate:inspector && npm run generate:duckkey && npm run generate:duckarchive && npm run generate:nest && npm run generate:druk",
    "new:inspector": "prisma migrate dev --config prisma-inspector.config.ts",
    "new:duckkey": "prisma migrate dev --config prisma-duckkey.config.ts",
    "new:duckarchive": "prisma migrate dev --config prisma-duckarchive.config.ts",
    "new:nest": "prisma migrate dev --config prisma-nest.config.ts",
    "new:druk": "prisma migrate dev --config prisma-druk.config.ts",
    "deploy:inspector": "prisma migrate deploy --config prisma-inspector.config.ts",
    "deploy:duckkey": "prisma migrate deploy --config prisma-duckkey.config.ts",
    "deploy:duckarchive": "prisma migrate deploy --config prisma-duckarchive.config.ts",
    "deploy:nest": "prisma migrate deploy --config prisma-nest.config.ts",
    "deploy:druk": "prisma migrate deploy --config prisma-druk.config.ts",
    "deploy": "npm run deploy:inspector && npm run deploy:duckkey && npm run deploy:duckarchive && npm run deploy:nest && npm run deploy:druk"
  },
  "author": {
    "name": "Alexandr Tovmach",
    "email": "alexandrtovmach@gmail.com"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "prisma": "^7.8.0",
    "prisma-zod-generator": "^2.1.2"
  },
  "peerDependencies": {
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "prisma-zod-generator": "^2.1.2"
  }
}
