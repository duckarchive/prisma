generator client {
  provider        = "prisma-client"
  output          = env("PRISMA_CLIENT_OUTPUT") // e.g., "generated/prisma/client"
  previewFeatures = ["partialIndexes"]
}

generator zod {
  provider = "prisma-zod-generator"
  output   = env("PRISMA_ZOD_OUTPUT") // e.g., "generated/prisma/zod"
}

datasource db {
  provider = "postgresql"
}

enum ResourceType {
  ARCHIUM
  FAMILY_SEARCH
  WIKIPEDIA
  BABYN_YAR
  WEBSITE
  GOOGLE_DRIVE
  USHMM
  AROLSEN
  LIBRARY
  LIBRARIA
}

enum TaskStatus {
  IDLE
  QUEUED
  PROCESSING
  FAILED
  COMPLETED
}

enum Availability {
  PUBLIC
  RESTRICTED
  PAYWALL
}

enum ActionType {
  report
  connect_to_online_copy
  disconnect_from_online_copy
  add_online_copy
  remove_online_copy
  add
  remove
  merge_to
  change_parent
  change_title
  change_code
  change_info
  add_year_range
  remove_year_range
  connect_to_author
  disconnect_from_author
  add_author
  remove_author
  change_author_title
  change_author_info
  change_author_tags
  change_author_location
  add_location
  remove_location
}

model Archive {
  id                     String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                   String                @db.VarChar(10)
  updated_at             DateTime?             @updatedAt @db.Timestamp(6)
  title                  String?               @db.Text
  info                   String?               @db.Text
  url                    String?               @db.VarChar(255)
  address                String?               @db.VarChar(255)
  phone_number           String?               @db.VarChar(20)
  email                  String?               @db.VarChar(255)
  logo_url               String?               @db.VarChar(255)
  family_search_projects FamilySearchProject[]
  daily_stats            DailyStat[]
  sync_tasks             SyncTask[]
  fonds                  Fond[]

  @@index([code])
  @@map("archives")
}

// authors_geog_idx: same geography GiST expression index as file_locations,
// partial on lat/lng NOT NULL — raw migration, not expressible here.
model Author {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  info         String?
  lat          Float?
  lng          Float?
  tags         String[]
  file_authors FileAuthor[]

  @@unique([title, lat, lng])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("authors")
}

model Resource {
  id                        String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  updated_at                DateTime?               @updatedAt @db.Timestamp(6)
  code                      String                  @db.VarChar(50)
  title                     String?                 @db.Text
  info                      String?                 @db.Text
  url                       String?                 @db.VarChar(255)
  logo_url                  String?                 @db.VarChar(255)
  type                      ResourceType?
  sync_tasks                SyncTask[]
  online_copies             OnlineCopy[]

  @@map("resources")
}

model FamilySearchPlace {
  id          Int       @id @db.Integer
  updated_at  DateTime? @updatedAt @db.Timestamp(6)
  title       String?   @db.VarChar(255)
  total_count Int?

  @@map("family_search_places")
}

model FamilySearchProject {
  id         String             @id
  synced_at  DateTime?          @db.Timestamp(6)
  archive_id String?            @db.Uuid
  archive    Archive?           @relation(fields: [archive_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items      FamilySearchItem[]

  @@map("family_search_projects")
}

model FamilySearchItem {
  id                  String              @id @db.VarChar(50)
  dgs                 String              @db.VarChar(50)
  archival_reference  String?             @db.Text
  volume              String?             @db.Text
  volumes             String?             @db.Text
  date                String?             @db.VarChar(50)
  image_count         Int?                @db.Integer
  project_id          String              @db.VarChar(50)
  project             FamilySearchProject @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  title               String?             @db.Text
  creator             String?             @db.Text
  indexed_child_count Int?                @db.Integer
  updated_at          DateTime            @default(now()) @updatedAt @db.Timestamp(6)
  cataloged_at        DateTime?           @db.Timestamp(6)

  @@map("family_search_items")
}

model DailyStat {
  created_at          DateTime @default(now()) @db.Timestamp(4)
  archive_id          String   @db.Uuid
  archive             Archive  @relation(fields: [archive_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  family_search_count Int      @default(0) @db.Integer
  archium_count       Int      @default(0) @db.Integer
  babyn_yar_count     Int      @default(0) @db.Integer
  wikipedia_count     Int      @default(0) @db.Integer
  google_drive_count  Int      @default(0) @db.Integer
  website_count       Int      @default(0) @db.Integer

  @@id([archive_id, created_at])
  @@map("daily_stats")
}

model SyncTask {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resource_id    String       @db.Uuid
  resource       Resource     @relation(fields: [resource_id], references: [id])
  archive_id     String?      @db.Uuid
  archive        Archive?     @relation(fields: [archive_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status         TaskStatus   @default(IDLE)
  priority       Int          @default(0)
  api_url        String       @db.Text
  api_params     Json         @db.JsonB
  last_run_at    DateTime?    @db.Timestamp(6)
  next_run_at    DateTime?    @db.Timestamp(6)
  retry_count    Int          @default(0)
  error_log      String?      @db.Text
  fond           Fond?        @relation(fields: [fond_id], references: [id])
  fond_id        String?      @db.Uuid
  inventory      Inventory?   @relation(fields: [inventory_id], references: [id])
  inventory_id   String?      @db.Uuid

  @@unique([resource_id, archive_id, fond_id, inventory_id, api_params])
  @@map("sync_tasks")
}

// catalog structure

model Fond {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String      @db.VarChar(20)
  updated_at  DateTime?   @updatedAt @db.Timestamp(6)
  title       String?     @db.Text
  info        String?     @db.Text
  archive_id  String      @db.Uuid
  archive     Archive     @relation(fields: [archive_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  years       FondYear[]
  sync_tasks  SyncTask[]
  inventories Inventory[]
  actions     FondActions[]

  @@unique([code, archive_id])
  @@index([code])
  @@index([archive_id])
  @@map("fonds")
}

model FondYear {
  fond_id    String @db.Uuid
  fond       Fond   @relation(fields: [fond_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  start_year Int
  end_year   Int

  @@id([fond_id, start_year, end_year])
  @@index([start_year, end_year])
  @@map("fond_years")
}

model FondActions {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at     DateTime        @default(now()) @db.Timestamp(6)
  created_by     String          @db.VarChar(255)
  resolved_at    DateTime?       @db.Timestamp(6)
  resolved_by    String?         @db.VarChar(255)
  type           ActionType
  note           String?         @db.Text
  is_rejected    Boolean?
  fond_id        String?         @db.Uuid
  fond           Fond?           @relation(fields: [fond_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  // at most one pending action per (type, fond) while unresolved
  @@unique([type, fond_id], where: raw("resolved_at IS NULL"))
  @@index([fond_id])
  @@map("fond_actions")
}

model Inventory {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String                @db.VarChar(20)
  updated_at    DateTime?             @updatedAt @db.Timestamp(6)
  title         String?               @db.Text
  info          String?               @db.Text
  fond_id       String                @db.Uuid
  fond          Fond                  @relation(fields: [fond_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  years         InventoryYear[]
  online_copies OnlineCopy[]
  sync_tasks    SyncTask[]
  files         File[]
  actions       InventoryActions[]

  @@unique([code, fond_id])
  @@index([code])
  @@index([fond_id])
  @@map("inventories")
}

model InventoryYear {
  inventory_id String    @db.Uuid
  inventory    Inventory @relation(fields: [inventory_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  start_year   Int
  end_year     Int

  @@id([inventory_id, start_year, end_year])
  @@index([start_year, end_year])
  @@map("inventory_years")
}

// Merged online-copies table: a copy belongs to at most one parent —
// either an inventory or a file (enforced by a CHECK constraint in the
// migration; Prisma can't express it). Both FKs NULL = unlinked copy,
// resolved downstream by matching `parsed` against the catalog tree.
//
// Identity: one row = one (url ↔ catalog node) edge.
//  - `source_key` is the scrapper's stable id of a claim within (resource_id, url):
//    the source's native item id where it has one, otherwise the code text itself.
//    NULL = row not written by the scrapper (manual add, editor imports, demoted
//    second edges) — exempt from the claim unique. `parsed` is the mutable claim
//    text, refreshed in place by every sync.
//  - one edge per (resource_id, url, file_id | inventory_id): partial uniques.
model OnlineCopy {
  id                      String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at              DateTime           @default(now()) @db.Timestamp(6)
  updated_at              DateTime           @default(now()) @updatedAt @db.Timestamp(6)
  checked_availability_at DateTime?          @db.Timestamp(6)
  resource_id             String             @db.Uuid
  resource                Resource           @relation(fields: [resource_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inventory_id            String?            @db.Uuid
  inventory               Inventory?         @relation(fields: [inventory_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  file_id                 String?            @db.Uuid
  file                    File?              @relation(fields: [file_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  url                     String             @db.Text
  availability            Availability?
  parsed                  String             @default("")
  source_key              String?
  inventory_actions       InventoryActions[]
  file_actions            FileActions[]

  @@unique([resource_id, url, source_key])
  @@unique([resource_id, url, file_id], where: raw("file_id IS NOT NULL"))
  @@unique([resource_id, url, inventory_id], where: raw("inventory_id IS NOT NULL"))
  @@index([parsed])
  @@index([parsed(ops: raw("gin_trgm_ops"))], type: Gin, name: "online_copy_parsed_gin_trgm_ops_idx")
  @@index([inventory_id])
  @@index([file_id])
  @@index([url], name: "online_copies_url_prefix_idx")
  // per-resource public counters (data/resources.ts in the inspector)
  @@index([resource_id], where: raw("availability = 'PUBLIC'"), name: "online_copies_public_by_resource_idx")
  @@map("online_copies")
}

model InventoryActions {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at     DateTime             @default(now()) @db.Timestamp(6)
  created_by     String               @db.VarChar(255)
  resolved_at    DateTime?            @db.Timestamp(6)
  resolved_by    String?              @db.VarChar(255)
  type           ActionType
  note           String?              @db.Text
  is_rejected    Boolean?
  online_copy_id String?              @db.Uuid
  online_copy    OnlineCopy?          @relation(fields: [online_copy_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  inventory_id   String?              @db.Uuid
  inventory      Inventory?           @relation(fields: [inventory_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  // at most one pending action per (type, target); three indexes emulate
  // NULLS NOT DISTINCT, which partial indexes can't express
  @@unique([type, online_copy_id, inventory_id], where: raw("resolved_at IS NULL"))
  @@unique([type, inventory_id], where: raw("resolved_at IS NULL AND online_copy_id IS NULL"))
  @@unique([type, online_copy_id], where: raw("resolved_at IS NULL AND inventory_id IS NULL"))
  @@index([inventory_id])
  @@index([online_copy_id])
  @@map("inventory_actions")
}

model File {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String           @db.VarChar(20)
  full_code     String           @default("")
  updated_at    DateTime?        @updatedAt @db.Timestamp(6)
  title         String?          @db.Text
  info          String?          @db.Text
  tags          String[]
  inventory_id  String           @db.Uuid
  inventory     Inventory        @relation(fields: [inventory_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  locations     FileLocation[]
  years         FileYear[]
  authors       FileAuthor[]
  online_copies OnlineCopy[]
  actions   FileActions[]

  @@unique([code, inventory_id])
  @@index([code])
  @@index([inventory_id])
  @@index([full_code])
  @@index([full_code(ops: raw("gin_trgm_ops"))], type: Gin, name: "file_full_code_gin_trgm_ops_idx")
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([info(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([tags], type: Gin)
  @@map("files")
}

model FileYear {
  file_id    String @db.Uuid
  file       File   @relation(fields: [file_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  start_year Int
  end_year   Int

  @@id([file_id, start_year, end_year])
  @@index([start_year, end_year])
  @@map("file_years")
}

// Geo-radius search relies on a GiST index over the expression
// ST_SetSRID(ST_MakePoint(lng, lat), 4326)::geography (file_locations_geog_idx),
// created by a raw migration — Prisma can't express expression indexes.
model FileLocation {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lat      Float
  lng      Float
  radius_m Int    @default(0)
  file_id  String @db.Uuid
  file     File   @relation(fields: [file_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([file_id, lat, lng, radius_m])
  @@map("file_locations")
}

model FileAuthor {
  file_id   String @db.Uuid
  author_id String @db.Uuid

  file   File   @relation(fields: [file_id], references: [id])
  author Author @relation(fields: [author_id], references: [id])

  @@id([file_id, author_id])
  @@index([author_id])
  @@map("file_authors")
}

model FileActions {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at     DateTime        @default(now()) @db.Timestamp(6)
  created_by     String          @db.VarChar(255)
  resolved_at    DateTime?       @db.Timestamp(6)
  resolved_by    String?         @db.VarChar(255)
  type           ActionType
  note           String?         @db.Text
  is_rejected    Boolean?
  online_copy_id String?         @db.Uuid
  online_copy    OnlineCopy?     @relation(fields: [online_copy_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  file_id        String?         @db.Uuid
  file           File?           @relation(fields: [file_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  // at most one pending action per (type, target); three indexes emulate
  // NULLS NOT DISTINCT, which partial indexes can't express
  @@unique([type, online_copy_id, file_id], where: raw("resolved_at IS NULL"))
  @@unique([type, file_id], where: raw("resolved_at IS NULL AND online_copy_id IS NULL"))
  @@unique([type, online_copy_id], where: raw("resolved_at IS NULL AND file_id IS NULL"))
  @@index([file_id])
  @@index([online_copy_id])
  @@map("file_actions")
}
